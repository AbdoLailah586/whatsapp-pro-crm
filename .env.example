# ==========================================
# WhatsApp Pro - Environment Variables Example
# Copy these to Koyeb / Cloud Platform Environment Variables
# ==========================================

# Port (Auto-assigned by Railway/Koyeb/Render, default 5000)
PORT=5000

# Neon PostgreSQL Database Connection (get this from your Neon project dashboard)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Secret used to sign login sessions - generate your OWN random value and
# keep it secret (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
# If this is not set, a random one is generated and saved locally on first boot,
# but on a host with no persistent disk (like Railway without a volume) that
# means everyone gets logged out on every redeploy - so always set this in
# your real deployment's environment variables.
JWT_SECRET=

# MicroMind AI Chatflow API Endpoint (optional - only if you use MicroMind AI replies)
MICROMIND_API_URL=

# Email Service Credentials (Gmail SMTP) - use a Gmail "App Password", never your real password
EMAIL_USER=
EMAIL_PASS=
EMAIL_SENDER_NAME=ReserveFlow & WhatsApp Pro
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465

# ==========================================================
# IMPORTANT: never commit real values for the variables above.
# This file is a TEMPLATE - copy it to `.env` for local development
# (which is already git-ignored) and set the real values as
# environment variables on your hosting platform (Railway: Service ->
# Variables) instead. If real secrets were ever committed here before,
# rotate them (change the Neon database password, generate a new Gmail
# App Password) since anything committed to git should be treated as
# permanently exposed.
# ==========================================================
